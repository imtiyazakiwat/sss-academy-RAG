# Names only. Set real values with `vercel env add <NAME> production`. Never commit a real .env file.

# Shared secret: Pluely sends it as "Authorization: Bearer <value>" (or x-api-key). REQUIRED. Unset = API refuses to run.
APP_API_KEY=

# Gemini key, or comma-separated list for rotation on 429. REQUIRED for chat. "AIzaSy..." = AI Studio, anything else = Vertex express.
GEMINI_API_KEY=
# Default Gemini model id (default: gemini-3.5-flash-lite, fastest in our benchmark).
GEMINI_MODEL=
# Comma-separated model ids a request may select via its "model" field (default: gemini-3.5-flash-lite,gemini-3.8-flash).
# Anything else falls back to GEMINI_MODEL, which is always allowed.
GEMINI_ALLOWED_MODELS=
# Thinking budget; 0 = off (default 0). Set to an empty string to omit thinkingConfig.
GEMINI_THINKING_BUDGET=
# Max output tokens when the request has no max_tokens (default 2048).
GEMINI_MAX_OUTPUT_TOKENS=
# Extra attempts after the first on 429/503 (default 2).
GEMINI_MAX_RETRIES=
# Base backoff in ms when there is no other key to switch to (default 1000).
GEMINI_RETRY_BASE_MS=
# Vertex express only (non-AIzaSy keys): project id (default patil-hospital-pos) and location (default global).
VERTEX_PROJECT_ID=
VERTEX_LOCATION=

# Groq keys for Whisper, comma-separated. REQUIRED for STT. Fallback name: GROQ_API_KEY.
GROQ_API_KEYS=
GROQ_API_KEY=
# Whisper model (default whisper-large-v3-turbo).
STT_MODEL=
# Optional Whisper vocabulary prompt.
STT_PROMPT=

# Allowed CORS origin (default *).
CORS_ALLOW_ORIGIN=
