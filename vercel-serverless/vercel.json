{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "functions": {
    "api/chat.ts": { "maxDuration": 60 },
    "api/stt.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/v1/chat/completions", "destination": "/api/chat" },
    { "source": "/chat/completions", "destination": "/api/chat" },
    { "source": "/v1/audio/transcriptions", "destination": "/api/stt" },
    { "source": "/audio/transcriptions", "destination": "/api/stt" },
    { "source": "/v1/models", "destination": "/api/models" },
    { "source": "/models", "destination": "/api/models" },
    { "source": "/health", "destination": "/api/health" }
  ]
}
